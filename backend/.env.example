DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lpk
DB_NAME=lpk
# Wajib: minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=
# Dipakai sekali untuk membuat akun owner pertama (minimal 8 karakter). Tidak menimpa password yang sudah diganti.
ADMIN_EMAIL=owner@lpk.id
ADMIN_PASSWORD=
# Origin frontend yang boleh memanggil API (pisahkan dengan koma). Jangan "*".
CORS_ORIGINS=http://localhost:3000
# Zona waktu bisnis (default Asia/Jakarta)
# LPK_TZ=Asia/Jakarta
# Mode dev saja: seed akun demo (password123) + /docs. JANGAN aktifkan di production.
# LPK_DEMO=1
# DOCUMENT_STORAGE_PATH=/var/lib/lpk/documents
# WhatsApp (optional): WA_ENABLED, WA_PROVIDER, WA_API_URL, WA_TOKEN, WA_SENDER_ID, WA_VERIFY_TOKEN, WA_APP_SECRET, WA_DRY_RUN, WA_LANGUAGE
